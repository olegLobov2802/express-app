DATABASE_URL=postgresql://express_app:express_app@localhost:5432/express_app
JWT_SECRET=change-me-to-a-long-random-secret
BCRYPT_ROUNDS=10
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Legacy fallback for access token TTL if JWT_ACCESS_EXPIRES_IN is unset
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
# Optional: comma-separated browser origins (e.g. http://localhost:3000)
# CORS_ORIGIN=
